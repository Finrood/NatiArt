Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/finrod/Documents/Programming/Java/Personal/NatiArt
ExecStart=/home/finrod/Documents/Programming/Java/Personal/NatiArt/scripts/loop-cycle.sh
